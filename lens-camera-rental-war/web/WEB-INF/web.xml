<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.1" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd">
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>
    <context-param>
        <param-name>DEFAULT_PAGE_SIZE</param-name>
        <param-value>12</param-value>
    </context-param>
    <context-param>
        <param-name>jakarta.faces.STATE_SAVING_METHOD</param-name>
        <param-value>client</param-value>
    </context-param>
    <session-config>
        <session-timeout>480</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>/faces/*</url-pattern>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>faces/client/pages/index.xhtml</welcome-file>
    </welcome-file-list>
    <!-- bảo mật admin area -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Admin Area</web-resource-name>
            <url-pattern>/faces/admin/*</url-pattern>
            <url-pattern>/admin/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
        </auth-constraint>
    </security-constraint>
    <security-role>
        <role-name>ADMIN</role-name>
    </security-role>
    <!-- xử lý lỗi -->
    <error-page>
        <error-code>404</error-code>
        <location>/faces/404.xhtml</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/faces/404.xhtml</location>
    </error-page>
    <error-page>
        <error-code>401</error-code>
        <location>/faces/404.xhtml</location>
    </error-page>
    <mime-mapping>
        <extension>webp</extension>
        <mime-type>image/webp</mime-type>
    </mime-mapping>
    <ejb-local-ref>
        <ejb-ref-name>DeviceModelsFacade</ejb-ref-name>
        <ejb-ref-type>Session</ejb-ref-type>
        <local>com.lens.device_model.facade.DeviceModelsFacadeLocal</local>
        <ejb-link>lens-camera-rental-ejb.jar#DeviceModelsFacade</ejb-link>
    </ejb-local-ref>
    <ejb-local-ref>
        <ejb-ref-name>DeviceModelsFacade1</ejb-ref-name>
        <ejb-ref-type>Session</ejb-ref-type>
        <local>com.lens.device_model.facade.DeviceModelsFacadeLocal</local>
        <ejb-link>lens-camera-rental-ejb.jar#DeviceModelsFacade</ejb-link>
    </ejb-local-ref>
    <ejb-local-ref>
        <ejb-ref-name>CartItemsFacade</ejb-ref-name>
        <ejb-ref-type>Session</ejb-ref-type>
        <local>com.lens.cart.facade.CartItemsFacadeLocal</local>
        <ejb-link>lens-camera-rental-ejb.jar#CartItemsFacade</ejb-link>
    </ejb-local-ref>
    <ejb-local-ref>
        <ejb-ref-name>RentalOrderApprovalService</ejb-ref-name>
        <ejb-ref-type>Session</ejb-ref-type>
        <local>com.lens.rental_orders.service.RentalOrderApprovalServiceLocal</local>
        <ejb-link>lens-camera-rental-ejb.jar#RentalOrderApprovalService</ejb-link>
    </ejb-local-ref>
</web-app>
